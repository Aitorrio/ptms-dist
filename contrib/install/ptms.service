[Unit]
Description=PTMS Personal Tetra Management System
Documentation=https://github.com/Aitorrio/ptms-dist
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/local/bin/ptms /etc/ptms/nucleus.toml
KillSignal=SIGINT
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
